{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modern-office",
  "main": "server/cloudflare.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/office", "/health"],
  },
  "durable_objects": {
    "bindings": [{ "name": "OFFICE", "class_name": "OfficeDurableObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OfficeDurableObject"] }],
  "observability": { "enabled": false },
}
