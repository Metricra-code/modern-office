# Local mode needs no cloud account. Hosted deployment requires a Cloudflare account.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3101/office
NEXT_PUBLIC_DEFAULT_MODE=demo
# build:public sets mode=live and same-origin NEXT_PUBLIC_REALTIME_URL=/office
REALTIME_PORT=3101
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
# GitHub Pages project sites: set to /your-repository-name before building.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_BASE_PATH=
# Optional self-hosted TURN. Browser credentials must be short-lived in production.
# NEXT_PUBLIC_TURN_URL=turn:your-own-host:3478
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
